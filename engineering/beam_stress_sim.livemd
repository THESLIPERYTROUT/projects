```elixir
if solution.fatigue do
  Kino.Layout.grid([
    Beam.Plots.fatigue_fos(sim_case, solution),
    Beam.Plots.fatigue_diagram(sim_case, solution)
  ])
else
  Kino.Markdown.new("This case has no `[fatigue]` section.")
end
